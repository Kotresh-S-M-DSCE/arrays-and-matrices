class Solution {
    int ret=0;
    public void fun(int[][] grid,int[][] check,int max,int i,int j)
    {
        if(i<0||j<0||i==grid.length||j==grid[0].length||grid[i][j]==-1||check[i][j]==1||(grid[i][j]==2&&max>0))
           return;
        if(grid[i][j]==2&&max==0)
        {
            ret++;
            return;
        }
        check[i][j]=1;
        fun(grid,check,max-1,i,j-1);
        fun(grid,check,max-1,i-1,j);
        fun(grid,check,max-1,i,j+1);
        fun(grid,check,max-1,i+1,j);
        check[i][j]=0;
    }
    public int uniquePathsIII(int[][] grid) {
        int sti=-1,stj=-1,obs=0;
        int[][] check=new int[grid.length][grid[0].length];
        for(int i=0;i<grid.length;i++)
        {
            for(int j=0;j<grid[0].length;j++)
            {
                if(grid[i][j]==1)
                {
                    sti=i;
                    stj=j;
                }
                if(grid[i][j]==-1)
                   obs++;
                check[i][j]=0;
            }
        }
        fun(grid,check,grid.length*grid[0].length-obs-1,sti,stj);
        return ret;
    }
}