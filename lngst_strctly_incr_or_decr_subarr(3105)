class Solution {
    public int longestMonotonicSubarray(int[] nums) {
        int j=1,max=1;
        while(j<nums.length)
        {
            int i=j-1;
            while(j<nums.length&&nums[j-1]<nums[j])
                j++;
            if(max<(j-i))
                max=j-i;
            j++;
        }
        j=1;
        while(j<nums.length)
        {
            int i=j-1;
            while(j<nums.length&&nums[j-1]>nums[j])
                j++;
            if(max<(j-i))
                max=j-i;
            j++;
        }
        return max;
    }
}