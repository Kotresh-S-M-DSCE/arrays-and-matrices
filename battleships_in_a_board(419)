class Solution {
    public void fun(char[][] board,int[][] visit,int i,int j)
    {
        if(i<0||j<0||i==board.length||j==board[0].length||visit[i][j]==1||board[i][j]=='.')
           return;
        visit[i][j]=1;
        fun(board,visit,i,j-1);
        fun(board,visit,i-1,j);
        fun(board,visit,i,j+1);
        fun(board,visit,i+1,j);
    }
    public int countBattleships(char[][] board) {
       int[][] visit=new int[board.length][board[0].length];
       int ret=0;
       for(int i=0;i<board.length;i++)
       {
           for(int j=0;j<board[0].length;j++)
           {
               if(board[i][j]=='X'&&visit[i][j]==0)
               {
                   ret++;
                   fun(board,visit,i,j);
               }
           }
       }
       return ret;
    }
}