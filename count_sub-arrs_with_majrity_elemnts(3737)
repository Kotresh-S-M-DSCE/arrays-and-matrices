class Solution {
    public int countMajoritySubarrays(int[] nums, int target) {
        int ret=0;
        for(int i=0;i<nums.length-1;i++)
        {
            int count=0;
            if(nums[i]==target)
            {
                ret++;
                count++;
            }
            for(int j=i+1;j<nums.length;j++)
            {
                if(nums[j]==target)
                   count++;
                if(count>(j-i+1)/2)
                   ret++;
            }
        }
        if(nums[nums.length-1]==target)
           ret++;
        return ret;
    }
}