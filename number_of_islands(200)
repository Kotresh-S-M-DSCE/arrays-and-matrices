class Solution {
    public void fun(char[][] grid,int[][] check,int i,int j)
    {
        if(i<0||j<0||i==grid.length||j==grid[0].length||check[i][j]==1||grid[i][j]=='0')
           return;
        check[i][j]=1;
        fun(grid,check,i,j-1);
        fun(grid,check,i-1,j);
        fun(grid,check,i,j+1);
        fun(grid,check,i+1,j);
    }
    public int numIslands(char[][] grid) {
        int[][] check=new int[grid.length][grid[0].length];
        int ret=0;
        for(int i=0;i<grid.length;i++)
        {
            for(int j=0;j<grid[0].length;j++)
            {
                if(grid[i][j]=='1'&&check[i][j]==0)
                {
                    ret++;
                    fun(grid,check,i,j);
                }
            }
        }
        return ret;
    }
}