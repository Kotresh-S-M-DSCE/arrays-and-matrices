class Solution {
    public int minimumDeletions(int[] nums) {
        int min=100000,max=-1,min_i=-1,max_i=-1;
        if(nums.length<3)
           return nums.length;
        for(int i=0;i<nums.length;i++)
        {
            if(nums[i]>max)
            {
                max=nums[i];
                max_i=i;
            }
            if(nums[i]<min)
            {
                min=nums[i];
                min_i=i;
            }
        }
        if(min_i>max_i)
        {
            int temp=max_i;
            max_i=min_i;
            min_i=temp;
        }
        int t1=min_i+(nums.length-max_i)+1,t2=max_i+1,t3=nums.length-min_i;
        return Math.min(t1,Math.min(t2,t3));
    }
}