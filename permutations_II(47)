class Solution {
    List<List<Integer>> ret=new ArrayList<>();
    public void fun(int[] nums,boolean[] bool,List<Integer> list)
    {
        if(list.size()==nums.length)
        {
            ret.add(new ArrayList<>(list));
            return;
        }
        int temp=100;
        for(int i=0;i<nums.length;i++)
        {
            if(bool[i]==false&&nums[i]!=temp)
            {
                temp=nums[i];
                list.add(nums[i]);
                bool[i]=true;
                fun(nums,bool,list);
                list.remove(list.size()-1);
                bool[i]=false;
            }
            
        }
    }
    public List<List<Integer>> permuteUnique(int[] nums) {
        //11223 11232 11322 
        Arrays.sort(nums);
        boolean[] bool=new boolean[nums.length];
        for(int i=0;i<nums.length;i++)
           bool[i]=false;
        fun(nums,bool,new ArrayList<>());
        return ret;
    }
}