class Solution {
    List<List<Integer>> ret=new ArrayList<>();
    public void fun(int[] c,int low,int sum,int t,List<Integer> list)
    {
        if(sum<t)
        {
            for(int i=low;i<c.length;i++)
            {
                sum+=c[i];
                list.add(c[i]);
                fun(c,i,sum,t,list);
                sum-=list.get(list.size()-1);
                list.remove(list.size()-1);
            }
        }
        else if(sum==t)
        {
            List<Integer> temp=new ArrayList<>(list);
            ret.add(temp);
        }
        else{}
    }
    public List<List<Integer>> combinationSum(int[] c, int t) {
        fun(c,0,0,t,new ArrayList<>());
        return ret;
    }
}