class Solution {
    public List<List<Integer>> fun(char[][] board,int[][] check,int i,int j)
    {
        if((i<=0||j<=0||i>=board.length-1||j>=board[0].length-1))
        {
            if(board[i][j]=='O')
                return new ArrayList<>();
            else
                return List.of(List.of(1));
        }
        if(board[i][j]=='X'||check[i][j]==1)
           return List.of(List.of(5));
        List<List<Integer>> ret=new ArrayList<>();
        check[i][j]=1;
        ret.add(List.of(i,j));
        List<List<Integer>> l1=fun(board,check,i,j-1);
        List<List<Integer>> l2=fun(board,check,i-1,j);
        List<List<Integer>> l3=fun(board,check,i,j+1);
        List<List<Integer>> l4=fun(board,check,i+1,j);
        if(l1.size()==0||l2.size()==0||l3.size()==0||l4.size()==0)
           return new ArrayList<>();
        if(l1.get(0).size()>1)
           ret.addAll(l1);
        if(l2.get(0).size()>1)
           ret.addAll(l2);
        if(l3.get(0).size()>1)
           ret.addAll(l3);
        if(l4.get(0).size()>1)
           ret.addAll(l4);
        return ret;
    }
    public void solve(char[][] board) {
        int[][] check=new int[board.length][board[0].length];
        List<List<Integer>> list=new ArrayList<>();
        for(int i=1;i<board.length-1;i++)
        {
            for(int j=1;j<board[0].length-1;j++)
            {
                if(board[i][j]=='O'&&check[i][j]==0)
                {
                    List<List<Integer>> temp=fun(board,check,i,j);
                    if(temp.size()>0)
                       list.addAll(temp);
                }
            }
        }
        for(int i=0;i<list.size();i++)
            board[list.get(i).get(0)][list.get(i).get(1)]='X';
    }
}