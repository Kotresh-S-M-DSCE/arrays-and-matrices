class Solution {
    public int fun(int[][] grid,int[][] visit,int i,int j)
    {
        if(i<0||j<0||i==grid.length||j==grid[0].length||grid[i][j]==0)
           return 1;
        if(visit[i][j]==1)
           return 0;
        visit[i][j]=1;
        int count=0,f1=fun(grid,visit,i,j-1),f2=fun(grid,visit,i-1,j),f3=fun(grid,visit,i,j+1),f4=fun(grid,visit,i+1,j);
        return f1+f2+f3+f4;
    }
    public int islandPerimeter(int[][] grid) {
        int ret=0;
        int[][] visit=new int[grid.length][grid[0].length];
        for(int i=0;i<grid.length;i++)
        {
            for(int j=0;j<grid[0].length;j++)
            {
                if(grid[i][j]==1&&visit[i][j]==0)
                   ret+=fun(grid,visit,i,j);
            }
        }
        return ret;
    }
}