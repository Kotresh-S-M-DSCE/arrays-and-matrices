class Solution {
    public int countServers(int[][] grid) {
        int[][] check=new int[grid.length][grid[0].length];
        for(int i=0;i<grid.length;i++)
        {
            int temp=-1;
            for(int j=0;j<grid[0].length;j++)
            {
                if(grid[i][j]==1)
                {
                    if(temp==-1)
                        temp=j;
                    else
                    {
                        check[i][j]=1;
                        check[i][temp]=1;
                    }
                }
            }
        }
        for(int i=0;i<grid[0].length;i++)
        {
            int temp=-1;
            for(int j=0;j<grid.length;j++)
            {
                if(grid[j][i]==1)
                {
                    if(temp==-1)
                        temp=j;
                    else
                    {
                        check[j][i]=1;
                        check[temp][i]=1;
                    }
                }
            }
        }
        int ret=0;
        for(int i=0;i<grid.length;i++)
        {
            for(int j=0;j<grid[0].length;j++)
            {
                if(check[i][j]==1)
                    ret++;
            }
        }
        return ret;
    }
}