class Solution {
    public boolean mergeTriplets(int[][] tr, int[] ta) {
        boolean t1=false,t2=false,t3=false;
        for(int i=0;i<tr.length;i++)
        {
            if(tr[i][0]==ta[0])
            {
                if(tr[i][1]<=ta[1]&&tr[i][2]<=ta[2])
                   t1=true;
            }
            if(tr[i][1]==ta[1])
            {
                if(tr[i][0]<=ta[0]&&tr[i][2]<=ta[2])
                   t2=true;
            }
            if(tr[i][2]==ta[2])
            {
                if(tr[i][0]<=ta[0]&&tr[i][1]<=ta[1])
                   t3=true;
            }
        }
        if(t1==true&&t2==true&&t3==true)
           return true;
        return false;
    }
} 