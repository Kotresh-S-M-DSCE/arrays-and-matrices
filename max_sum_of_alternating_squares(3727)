class Solution {
    public long maxAlternatingSum(int[] nums) {
        for(int i=0;i<nums.length;i++)
        {
            if(nums[i]<0)
               nums[i]=-nums[i];
        }
        Arrays.sort(nums);
        long ret=0;
        for(int i=0;i<nums.length/2;i++)
            ret-=nums[i]*nums[i];
        for(int i=nums.length/2;i<nums.length;i++)
            ret+=nums[i]*nums[i];
        return ret;
    }
}