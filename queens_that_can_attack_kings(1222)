class Solution {
    public List<List<Integer>> queensAttacktheKing(int[][] queens, int[] king) {
        int cmin1=1000,cmin2=1000,rmin1=1000,rmin2=1000,row1=-1,row2=-1,col1=-1,col2=-1,d00=1000,d01=1000,d10=1000,d11=1000;
        for(int i=0;i<queens.length;i++)
        {
            if(queens[i][0]==king[0])
            {
                if(queens[i][1]<king[1])
                {
                   if(Math.abs(queens[i][1]-king[1])<rmin1)
                   {
                      rmin1=Math.abs(queens[i][1]-king[1]);
                      row1=queens[i][1];
                   }
                }
                else
                {
                    if(Math.abs(queens[i][1]-king[1])<rmin2)
                   {
                      rmin2=Math.abs(queens[i][1]-king[1]);
                      row2=queens[i][1];
                   }
                } 
            }
            if(queens[i][1]==king[1])
            {
                if(queens[i][0]<king[0])
                {
                   if(Math.abs(queens[i][0]-king[0])<cmin1)
                   {
                      cmin1=Math.abs(queens[i][0]-king[0]);
                      col1=queens[i][0];
                   }
                }
                else
                {
                    if(Math.abs(queens[i][0]-king[0])<cmin2)
                    {
                       cmin2=Math.abs(queens[i][0]-king[0]);
                       col2=queens[i][0];
                    }
                }
            }
            if(Math.abs(king[0]-queens[i][0])==Math.abs(king[1]-queens[i][1]))
            {
                if(king[0]>queens[i][0]&&king[1]>queens[i][1]&&d00>king[1]-queens[i][1])
                   d00=king[1]-queens[i][1];
                else if(king[0]>queens[i][0]&&king[1]<queens[i][1]&&d01>king[0]-queens[i][0])
                   d01=king[0]-queens[i][0];
                else if(king[0]<queens[i][0]&&king[1]>queens[i][1]&&d10>king[1]-queens[i][1])
                   d10=king[1]-queens[i][1];
                else if(king[0]<queens[i][0]&&king[1]<queens[i][1]&&d11>queens[i][1]-king[1])
                   d11=queens[i][1]-king[1];
                else{};
            }
        }
        List<List<Integer>> list=new ArrayList<>();
        if(cmin1!=1000)
           list.add(new ArrayList<>(Arrays.asList(col1,king[1])));
        if(rmin1!=1000)
           list.add(new ArrayList<>(Arrays.asList(king[0],row1)));
        if(cmin2!=1000)
           list.add(new ArrayList<>(Arrays.asList(col2,king[1])));
        if(rmin2!=1000)
           list.add(new ArrayList<>(Arrays.asList(king[0],row2)));
        if(d00!=1000)
           list.add(new ArrayList<>(Arrays.asList(king[0]-d00,king[1]-d00)));
        if(d01!=1000)
           list.add(new ArrayList<>(Arrays.asList(king[0]-d01,king[1]+d01)));
        if(d10!=1000)
           list.add(new ArrayList<>(Arrays.asList(d10+king[0],king[1]-d10)));
        if(d11!=1000)
           list.add(new ArrayList<>(Arrays.asList(d11+king[0],d11+king[1])));
        return list;
    }
}