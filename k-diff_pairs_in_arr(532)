class Solution {
    public int findPairs(int[] nums, int k) {
        //1,1,3,4,5
        Arrays.sort(nums);
        int ret=0,i=0,j=1;
        while(j<nums.length)
        {
            int flag=0;
            if(i>0&&nums[i]==nums[i-1])
            {
                i++;
                j=i+1;
            }
            else
            {
                if(Math.abs(nums[i]-nums[j])==k)
                {
                    ret++;
                    i++;
                    j=i+1;
                }
                else if(Math.abs(nums[i]-nums[j])>k)
                {
                    i++;
                    j=i+1;
                }
                else
                    j++;
            }
        }
        return ret;
    }
}