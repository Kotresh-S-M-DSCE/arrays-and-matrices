class Solution {
    public int minimizeSum(int[] nums) {
        //1 1 1 3 5 7  1 2 2 3 5 7  1 1 1 2 2 3
        //1 2 3 6 8 9  3 4 4 6 8 9  1 2 3 5 5 6
        //1 2 6 8  6 7 7 8  1 1 1 2
        //1 2 5 6 8
        //1 1 1 1 1
        //1 4 5 7 8
        //8 28 42 58 75
        Arrays.sort(nums);
        return Math.min(Math.min(Math.abs(nums[2]-nums[nums.length-1]),Math.abs(nums[0]-nums[nums.length-3])),Math.abs(nums[1]-nums[nums.length-2]));
    }
}