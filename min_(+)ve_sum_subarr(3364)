class Solution {
    public int minimumSumSubarray(List<Integer> nums, int l, int r) {
        int min=100000000;
        for(int i=l;i<=r;i++)
        {
            int sum=0,k=0;
            for(int j=0;j<i;j++)
                sum+=nums.get(j);
            if(sum>0&&sum<min)
                min=sum;
            for(int j=i;j<nums.size();j++)
            {
                sum+=nums.get(j);
                sum-=nums.get(k++);
                if(sum>0&&sum<min)
                    min=sum;
            }
        }
        if(min==100000000)
            return -1;
        return min;
    }
}