class Solution {
    public int maxNumberOfFamilies(int n, int[][] rs) {
        Map<Integer,List<Integer>> map=new HashMap<>();
        for(int i=0;i<rs.length;i++)
        {
            if(!map.containsKey(rs[i][0]))
               map.put(rs[i][0],new ArrayList<>());
            List<Integer> list=map.get(rs[i][0]);
            list.add(rs[i][1]); 
        }
        int count=0;
        for(Map.Entry<Integer,List<Integer>> entry : map.entrySet())
        {
            List<Integer> list=entry.getValue();
            int a=0,b=0,c=0;
            for(int i=0;i<list.size();i++)
            {
                if(list.get(i)==2||list.get(i)==3)
                   a=1;
                if(list.get(i)==4||list.get(i)==5)
                {
                    a=1;
                    b=1;
                }
                if(list.get(i)==6||list.get(i)==7)
                {
                    b=1;
                    c=1;
                }
                if(list.get(i)==8||list.get(i)==9)
                   c=1;
            }
            if((a+b+c)==0)
               count+=2;
            if((a+b+c)==1||(a+b+c)==2)
               count+=1;
        }
        return count+2*(n-map.size());
    }
}