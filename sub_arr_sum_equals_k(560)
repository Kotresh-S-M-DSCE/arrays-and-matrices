class Solution {
    public int subarraySum(int[] nums, int k) {
        Map<Integer,Integer> map=new HashMap<>();
        int sum=0,count=0;
        map.put(0,1);
        for(int i=0;i<nums.length;i++)
        {
            sum+=nums[i];
            if(map.containsKey(sum-k))
            {
                int temp=map.get(sum-k);
                count+=temp;
            }
            if(!map.containsKey(sum))
               map.put(sum,1);
            else
            {
                int temp=map.get(sum);
                map.put(sum,temp+1);
            }
        }
        return count;
    }
}