class Solution {
    public int numOfSubarrays(int[] arr) {
        // 1,2,3,5, 4, 6, 1, 8, 3, 4
        // 1,3,6,11,15,21,22,30,33,37
        // [1][1,2][3][2,3][5][1,2,3,5][1,2,3,5,4][5,4][1,2,3,5,4,6][5,4,6][1][4,6,1][6,1]
        // [3,5,4,6,1][2,3,5,4,6,1][1,8][4,6,1,8][6,1,8][3,5,4,6,1,8][2,3,5,4,6,1,8][3][8,3]
        // [5,4,6,1,8,3][1,2,3,5,4,6,1,8,3][3,4][8,3,4][5,4,6,1,8,3,4][1,2,3,5,4,6,1,8,3,4]
        // [1,2,3,4, 5, 6, 7]
        // [1,3,6,10,15,21,28]
        //e[1,1,2,3, 3, 3, 4]
        //o[1,2,2,2, 3, 4, 4]
        int ret=0,sum=0,even=1,odd=0;
        for(int i=0;i<arr.length;i++)
        {
            sum+=arr[i];
            if(sum%2==0)
            {
                ret%=1000000007;
                ret+=odd;
            }
            else
            {
                ret%=1000000007;
                ret+=even;
            }
            if(sum%2==0)
                even++;
            else
                odd++;
        }
        return ret;
    }
}