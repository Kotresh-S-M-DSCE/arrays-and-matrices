class Solution {
    public int maximumProduct(int[] nums) {
        Arrays.sort(nums);
        List<Integer> list=new ArrayList<>();
        for(int i=0;i<nums.length;i++)
        {
            if(nums[i]!=0)
               list.add(nums[i]);
        }
        if(list.size()<3)
           return 0;
        int max=list.get(list.size()-3)*list.get(list.size()-2)*list.get(list.size()-1);
        if(max<list.get(0)*list.get(1)*list.get(list.size()-1))
           max=list.get(0)*list.get(1)*list.get(list.size()-1);
        if(max<0&&list.size()<nums.length)
           return 0;
        return max;
    }
}